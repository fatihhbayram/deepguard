# Every variable in this file with a value below is REQUIRED (R1-T5). None of them has a
# default any more: `docker compose` refuses to start the stack without the credentials, and
# the API and the worker refuse to start without them inside the container — see
# `apps/api/app/config.py`. The values here are development credentials and must be changed
# before this is deployed anywhere shared.

# PostgreSQL — required.
POSTGRES_USER=deepguard
POSTGRES_PASSWORD=deepguard
POSTGRES_DB=deepguard
POSTGRES_HOST_PORT=5432

# MinIO — required. These authenticate the bucket the original uploads are kept in.
MINIO_ROOT_USER=deepguard
MINIO_ROOT_PASSWORD=deepguard123
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# API
API_PORT=8000

# Web
WEB_PORT=3000
# API base URL used by the browser. Must be reachable from the host.
# Server-side rendering uses http://api:8000 over the Docker network (set in docker-compose.yml).
NEXT_PUBLIC_API_URL=http://localhost:8000
# The origin the dashboard is opened on, and the only one the API accepts a signed-in
# submission or sign-out from. Change it together with WEB_PORT, and set it to the real
# public origin (https://...) when deploying — a mismatch refuses every submission with 403.
DEEPGUARD_WEB_ORIGIN=http://localhost:3000

# Everything below is OPTIONAL. Without it the stack starts and an analysis still runs to
# completion — the detector that could not be reached records a failed or unavailable signal
# instead of a score.

# NVIDIA Synthetic Video Detector (hosted Preview / Try API)
# Key is personal — get one from https://build.nvidia.com/nvidia/synthetic-video-detector
NVIDIA_API_KEY=
# NVCF function ID for the hosted detector, from the NVIDIA function catalog.
NVIDIA_SVD_FUNCTION_ID=847b6e53-0133-452d-ab85-d7acf3ace723

# NVIDIA Active Speaker Detection (hosted Preview / Try API)
# Same personal key as above — https://build.nvidia.com/nvidia/active-speaker-detection
# NVCF function ID for the hosted `ai-active-speaker-detection` function. It is a separate
# deployment from the synthetic-video detector and does not share its function ID.
NVIDIA_ASD_FUNCTION_ID=f286f937-05c4-454b-8312-fba67a2a6fa7

# Local speaker diarization (pyannote/speaker-diarization-community-1)
# The Active Speaker NIM does not diarize — it takes speaker turns as an input — so they are
# produced locally. The model is gated: the token must belong to a Hugging Face account that
# has accepted its conditions at
# https://huggingface.co/pyannote/speaker-diarization-community-1
# A read-only token is enough. Without it diarization records an unavailable signal.
HUGGINGFACE_TOKEN=

# Which deployment this is. Unset means production: the web session cookie is marked
# `Secure` and both processes log JSON. Set it to `development` for a plain-HTTP local stack,
# where a `Secure` cookie would be discarded by the browser and sign-in would not work.
DEEPGUARD_ENV=development

# Whether the worker runs uncalibrated experimental workloads in shadow mode (R6-T1). Unset
# means off. Set it to `true` to have every completed analysis queue a shadow run, which the
# worker executes on an idle poll and writes to `shadow_runs` alone — never to the forensic
# evidence, a report, a public API response or the risk engine.
DEEPGUARD_SHADOW_MODE=

# Where a shadow run executes (R6-T2). Unset means in the worker process, which is the R6-T1
# behaviour. Set it to `true` — and set both Modal tokens below — to run the shadow workload
# on a remote NVIDIA GPU rented from Modal instead.
#
# This is a second switch rather than a value of the one above on purpose: the first decides
# whether experiments run at all, this one decides where. Both are needed, and either alone
# changes nothing: shadow mode without Modal keeps running the local stub, and Modal tokens
# without shadow mode queue nothing to run.
#
# Nothing here can affect an analysis. A Modal that is not deployed, not reachable, not paid
# for or not configured fails the shadow run it was asked for and nothing else — the report,
# the public API and the risk engine never see a shadow observation either way. Deploy the
# remote half first:
#
#   modal deploy apps/api/app/modal_shadow_app.py
DEEPGUARD_SHADOW_MODAL=

# Modal credentials, under the names Modal's own SDK reads. Create them with `modal token new`
# (they land in ~/.modal.toml) or from the workspace settings at https://modal.com/settings.
# Empty is absent: with either one missing, shadow runs stay local and nothing else changes.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# How long the worker waits for a Modal shadow run before giving up on it. Seconds; unset
# means 900. It bounds the local wait, not the remote container — Modal enforces its own
# limit, set in `apps/api/app/modal_shadow_app.py` — and it is generous because the first run
# after a quiet period pays a GPU cold start.
DEEPGUARD_SHADOW_MODAL_TIMEOUT_SECONDS=

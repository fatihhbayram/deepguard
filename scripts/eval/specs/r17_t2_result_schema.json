{
 "schema": "r17-t2-result-schema-1",
 "description": "One row per case in results.csv / results.json (key `cases`). Columns in this order. No clip_sha_drift column: a clip hash mismatch is a hard stop (hash_blocked), never a tolerated drift.",
 "signals": ["synthetic_video", "face_manipulation", "lip_forensics", "audio_authenticity", "active_speaker", "provenance"],
 "columns": [
  {"name": "case_id", "type": "string", "nullable": false},
  {"name": "source_cluster_id", "type": "string", "nullable": false},
  {"name": "truth", "type": "string", "nullable": false, "enum": ["AI", "REAL"]},
  {"name": "blind_id", "type": "string", "nullable": false, "pattern": "^B[0-9]{3}$"},
  {"name": "analysis_id", "type": "string", "nullable": true},
  {"name": "status", "type": "string", "nullable": true},
  {"name": "risk_level", "type": "string", "nullable": true},
  {"name": "risk_rule_id", "type": "string", "nullable": true},
  {"name": "risk_rules_version", "type": "string", "nullable": true},
  {"name": "risk_calibration_id", "type": "string", "nullable": true},
  {"name": "final_state", "type": "string", "nullable": false, "enum": ["hash_blocked", "operational_failure", "protocol_violation", "abstention", "positive", "negative"]},
  {"name": "confusion", "type": "string", "nullable": true, "enum": ["TP", "FN", "FP", "TN", null]},
  {"name": "signals_synthetic_video_status", "type": "string", "nullable": true},
  {"name": "signals_synthetic_video_score", "type": "number", "nullable": true},
  {"name": "signals_face_manipulation_status", "type": "string", "nullable": true},
  {"name": "signals_face_manipulation_score", "type": "number", "nullable": true},
  {"name": "signals_lip_forensics_status", "type": "string", "nullable": true},
  {"name": "signals_lip_forensics_score", "type": "number", "nullable": true},
  {"name": "signals_audio_authenticity_status", "type": "string", "nullable": true},
  {"name": "signals_audio_authenticity_score", "type": "number", "nullable": true},
  {"name": "signals_active_speaker_status", "type": "string", "nullable": true},
  {"name": "signals_active_speaker_score", "type": "number", "nullable": true},
  {"name": "signals_provenance_status", "type": "string", "nullable": true},
  {"name": "signals_provenance_score", "type": "number", "nullable": true},
  {"name": "enrichment_state", "type": "string", "nullable": true},
  {"name": "decision_latency_s", "type": "number", "nullable": true},
  {"name": "error", "type": "string", "nullable": true}
 ],
 "csv": {"null": "N/A", "encoding": "utf-8", "header": true}
}
